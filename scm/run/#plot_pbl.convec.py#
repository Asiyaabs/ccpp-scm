import numpy as np
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
from netCDF4 import Dataset

with Dataset("output_twpice_SCM_GFS_v17_p8_ugwpv1/output.nc") as ds:
#with Dataset("output_twpice_SCM_GFS_v17_p8_ugwpv1_pbl_convec/output.nc") as ds:

    qv = ds.variables['qv'][:]
    qv_tag = ds.variables['qv_tag'][:]

nt = qv.shape[0]
t_axis = np.arange(nt)
gap = np.max(np.abs(qv_tag - qv), axis=(1,2))

#lev = 95
levs = [0, 50, 75, 90, 95, 100, 120, 126]

for lev in levs:
    qv_lev = qv[:, lev, 0]
    qvtag_lev = qv_tag[:, lev, 0]
    
    fig, axes = plt.subplots(2, 1, figsize=(12, 8), sharex=True)
    
    axes[0].plot(t_axis, qv_lev, label='qv', linewidth=1)
    axes[0].plot(t_axis, qvtag_lev, label='qv_tag', linewidth=1, linestyle='--')
    axes[0].set_ylabel('specific humidity (kg/kg)')
    axes[0].set_title('qv vs qv_tag at level 0 (deep convection ON, corrected fix; MP + shalconv still OFF)')
    axes[0].legend()
    
    axes[1].plot(t_axis, gap, color='red', linewidth=1)
    axes[1].set_ylabel('max|qv_tag - qv| (whole column)')
    axes[1].set_xlabel('timestep')
    axes[1].set_title('Gap magnitude over time')
    
    plt.tight_layout()
    plt.savefig(f'All.png', dpi=150)
    #plt.savefig(f'qv_qvtag_dcnv_fixed.{lev}.qv0.png', dpi=150)
    print("saved qv_qvtag_dcnv_fixed.png")
